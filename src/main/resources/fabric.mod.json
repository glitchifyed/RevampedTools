{
  "schemaVersion": 1,
  "id": "revampedtools",
  "version": "${version}",
  "name": "Revamped Tools",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/revampedtools/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.glitchifyed.revampedtools.client.RevampedtoolsDataGenerator"
